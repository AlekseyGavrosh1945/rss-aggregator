# Токен бота от @BotFather. Пусто — бот отключён, работает только сбор фидов.
BOT_TOKEN=

# Строка подключения к PostgreSQL.
DATABASE_URL=postgres://rss:rss@localhost:5432/rss?sslmode=disable

# Как часто опрашивать фиды (Go duration: 30s, 1m, 5m...).
FETCH_INTERVAL=1m

# Таймаут загрузки одного фида.
FETCH_TIMEOUT=15s

# Сколько горутин параллельно опрашивают фиды.
WORKERS=8

# Адрес HTTP-сервера с /healthz.
HTTP_ADDR=:8080
